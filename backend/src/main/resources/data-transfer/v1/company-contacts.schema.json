{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "company-contacts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "userId",
    "email"
  ],
  "properties": {
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "email": {
      "type": "string",
      "minLength": 3,
      "maxLength": 254,
      "x-maxUtf16Length": 254,
      "x-trimmed": true,
      "x-minUtf16Length": 3
    }
  }
}
