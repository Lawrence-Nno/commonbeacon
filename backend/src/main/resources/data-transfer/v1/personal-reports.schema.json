{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "personal-reports",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "questionId",
    "replyId",
    "reason",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "questionId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "replyId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "x-maxUtf16Length": 2000,
      "x-trimmed": true,
      "x-minUtf16Length": 5
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
