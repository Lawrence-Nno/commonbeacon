{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "company-users",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "displayName",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "x-maxUtf16Length": 80,
      "x-trimmed": true,
      "x-minUtf16Length": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceInstanceId",
        "sourceId"
      ],
      "properties": {
        "sourceInstanceId": {
          "type": "string",
          "format": "uuid"
        },
        "sourceId": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  }
}
