# Local development only. Copy to .env and replace the password.
POSTGRES_DB=commonbeacon
POSTGRES_USER=commonbeacon
POSTGRES_PASSWORD=replace-for-local-development
POSTGRES_PORT=5432

# Optional sample accounts and onboarding boards; only the local profile can seed.
DEMO_SEED_ENABLED=false
# Set a unique 12-128 character local demo password before enabling.
DEMO_PASSWORD=

# Local Compose frontend port (database/backend ports require compose.host.yaml).
FRONTEND_PORT=8081
BACKEND_PORT=8080

# Destructive company erasure also requires an administrator's reviewed confirmation.
COMPANY_ERASURE_ENABLED=false
# Operator-enforced backup expiry promise (1-365 days); see docs/offboarding.md.
ERASURE_BACKUP_RETENTION_DAYS=30

# Retain legacy ACTIVE access until the verified-account rollout is qualified.
# ENFORCED requires proof for community/company authority; pending privacy access remains.
EMAIL_VERIFICATION_MODE=TRANSITION

# Outbox stays disabled until external AES-256 keys are supplied. Never commit real keys.
EMAIL_OUTBOX_ENABLED=false
EMAIL_OUTBOX_ACTIVE_KEY=
# Format: key-id=base64-32-byte-key[,old-key-id=base64-32-byte-key]
EMAIL_OUTBOX_KEYS=
